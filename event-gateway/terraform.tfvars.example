# ============================================================================
# Konnect Configuration
# ============================================================================
# Copy this file to terraform.tfvars and fill in your values

konnect_server_url = "https://us.api.konghq.com"
# konnect_token      = "YOUR_KONNECT_PAT"

# ============================================================================
# Event Gateway Configuration
# ============================================================================

event_gateway_name = "event-driven-ai-patterns-gateway"

backend_cluster_bootstrap_servers = [
  "kafka1:9092",
  "kafka2:9092",
  "kafka3:9092"
]

# ============================================================================
# Docker / Data Plane Configuration
# ============================================================================

konnect_region = "us"
konnect_domain = "konghq.com"
