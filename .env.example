# =============================================================================
# event-driven-ai-patterns-demo — environment variables
# Copy this file to .env and fill in the values you need for the pieces
# you're running (not every service needs every variable).
# =============================================================================

# ---------------------------------------------------------------------------
# OpenAI (used by anomaly-detector-agent, sentinel-agent, dispatch-agent via
# volcano-sdk, and by the ai-gateway's ai-proxy / ai-rag-injector plugins)
# ---------------------------------------------------------------------------
# Required — no default. Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Chat model used by the LLM-powered agents and the ai-proxy /chat route
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Kafka / Kong Event Gateway (KEG)
# ---------------------------------------------------------------------------
# Bootstrap address for the single Zion_Mainframe KEG virtual cluster.
# All app-level services (data-generator, anomaly-detector-agent,
# sentinel-agent, dispatch-agent, context-updater) connect here.
KAFKA_BROKER=localhost:19092

# Direct backend Kafka cluster bootstrap servers (bypasses KEG entirely).
# Used only by kafkactl / raw debugging access, not by the app services.
KAFKA_BACKEND_BROKERS=localhost:9092,localhost:9093,localhost:9094

# ---------------------------------------------------------------------------
# Kong Gateway (Admin API + AI Gateway proxy)
# ---------------------------------------------------------------------------
# Kong Admin API — used by context-updater and anomaly-detector-agent-style
# services to discover the ai-rag-injector plugin ID at startup.
KONG_ADMIN_URL=http://localhost:8001

# Kong AI Gateway proxy — fronts the /chat route (ai-proxy + ai-rag-injector).
# Defaults to the data plane's HTTPS proxy port (matrix-ui's default matches);
# use http://localhost:8000 instead if you'd rather avoid its self-signed cert.
KONG_AI_GATEWAY_URL=https://localhost:8443

# Name of the vector-store collection used for Oracle RAG context.
RAG_COLLECTION=oracle-knowledge

# ---------------------------------------------------------------------------
# Konnect (used only by kongctl, to provision Kong Event Gateway)
# ---------------------------------------------------------------------------
# Personal access token used by the `kongctl` CLI. Export this directly in
# your shell before running `kongctl apply` — it does not need to live in a
# committed .env file:
#   export KONGCTL_DEFAULT_KONNECT_PAT=<your-personal-access-token>
#
# The KEG data-plane container's own Konnect connection details (region,
# domain, cluster ID, mTLS cert/key) live in event-gateway/konnect.env —
# see event-gateway/konnect.env.example.
