# Copy to konnect.env and fill values before running `docker compose up` in
# this directory. See the root README's "Provision Kong AI Gateway" section
# for step-by-step instructions.

# ── Konnect connection (Kong Gateway data-plane, hybrid mode) ────────────────
# Obtain these exact hostnames after applying kongctl/data_plane_certificate.yaml.
# The root README's Setup section fills them in for you automatically:
#   kongctl get gateway control-plane ai-gateway --output json --jq '.config.control_plane_endpoint'
#   kongctl get gateway control-plane ai-gateway --output json --jq '.config.telemetry_endpoint'
# or copy them by hand from Konnect: Gateway Manager -> ai-gateway control
# plane -> "New Data Plane Node" -> Docker tab. They are unique to your
# Konnect region/org and look like:
#   KONG_CLUSTER_CONTROL_PLANE=abcd1234.us.cp0.konghq.com:443
#   KONG_CLUSTER_TELEMETRY_ENDPOINT=abcd1234.us.tp0.konghq.com:443
KONG_CLUSTER_CONTROL_PLANE=<your-control-plane-endpoint>:443
KONG_CLUSTER_SERVER_NAME=<your-control-plane-endpoint>
KONG_CLUSTER_TELEMETRY_ENDPOINT=<your-telemetry-endpoint>:443
KONG_CLUSTER_TELEMETRY_SERVER_NAME=<your-telemetry-endpoint>

# ── OpenAI ─────────────────────────────────────────────────────────────────
# Resolved at runtime by the {vault://env/OPENAI_API_KEY} references inside
# kongctl/kong.yaml (ai-proxy chat route + ai-rag-injector embeddings). Kong
# reads this from its own process environment regardless of how the plugin
# config was delivered (decK/Konnect push vs. a local declarative file), so
# it must be set on this data-plane container.
OPENAI_API_KEY=
