# Kafka broker (kafkajs client in matrix-ui/server)
KAFKA_BROKER=localhost:19092

# Kong AI Gateway base URL (ai-proxy + ai-rag-injector route lives at ${KONG_AI_GATEWAY_URL}/chat)
# Defaults to the data plane's HTTPS proxy port; if it uses a self-signed
# cert, Node's fetch will reject it unless NODE_TLS_REJECT_UNAUTHORIZED=0 is
# set for this process (dev-only) or a trusted cert is configured.
KONG_AI_GATEWAY_URL=https://localhost:8443

# React dev server port (CRA)
PORT=3000

# Express/WS backend-for-frontend server port
SERVER_PORT=3001
